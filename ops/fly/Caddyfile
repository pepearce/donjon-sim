{
	auto_https off
	admin off
}

:8080 {
	@sse path /api/v1/stream
	handle @sse {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
			transport http {
				response_header_timeout 0
			}
		}
	}

	handle /api/v1/* {
		reverse_proxy 127.0.0.1:8787
	}

	handle /healthz {
		reverse_proxy 127.0.0.1:8787
	}

	handle {
		encode gzip
		reverse_proxy 127.0.0.1:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
